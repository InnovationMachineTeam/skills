{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/InnovationMachineTeam/skills/docs/schemas/agent-skills-map.schema.json",
  "title": "Agent Capability Bindings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "updated_at", "bindings"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "revision": {"type": "integer", "minimum": 0},
    "updated_at": {"type": "string", "format": "date-time"},
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "agent_ref", "capability_ref", "mode", "capabilities", "activation", "constraints", "evidence", "status", "accountable_owner"],
        "properties": {
          "id": {"type": "string", "pattern": "^binding://[a-z0-9][a-z0-9./-]*$"},
          "agent_ref": {"type": "string", "pattern": "^asset://[^@]+@[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "capability_ref": {"type": "string", "pattern": "^asset://[^@]+@(?:\\^)?[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "mode": {"enum": ["required", "optional", "fallback"]},
          "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "activation": {"enum": ["always", "on_intent", "by_orchestrator", "explicit"]},
          "constraints": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["candidate", "verified", "deprecated", "revoked"]},
          "accountable_owner": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
