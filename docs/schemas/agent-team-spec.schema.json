{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/InnovationMachineTeam/skills/docs/schemas/agent-team-spec.schema.json",
  "title": "Agent Team Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "version", "accountable_owner", "goal", "agent_refs", "workflow", "model_policy_refs", "skill_map_revision", "worktree_policy", "evaluation", "lifecycle"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^asset://(project|repository)/team/[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "accountable_owner": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "agent_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "workflow": {"type": "object", "required": ["pattern", "stages"], "properties": {"pattern": {"enum": ["sequential", "parallel", "dag", "dynamic", "manager", "handoff"]}, "stages": {"type": "array", "minItems": 1, "items": {"type": "object"}}}},
    "model_policy_refs": {"type": "array", "items": {"type": "string"}},
    "skill_map_revision": {"type": "integer", "minimum": 0},
    "worktree_policy": {"enum": ["none", "single", "per-worker", "dynamic"]},
    "evaluation": {"type": "object"},
    "lifecycle": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["draft", "candidate", "verified", "approved", "active", "suspended", "deprecated", "retired"]}}}
  }
}
