{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/InnovationMachineTeam/skills/docs/schemas/agent-team-spec.schema.json",
  "title": "Agent Team Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "version", "status", "accountable_owner", "goal", "non_goals", "risk_tier", "roles", "workflow", "capability_placement", "model_policy_refs", "worktree_policy", "human_checkpoints", "evaluation", "rollback", "retirement"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^asset://(project|repository)/team/[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "status": {"enum": ["draft", "candidate", "verified", "approved"]},
    "accountable_owner": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "risk_tier": {"enum": ["R0", "R1", "R2", "R3"]},
    "roles": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "mission", "non_goals", "boundary_evidence", "inputs", "outputs", "tools", "permissions", "data_classes", "model_policy_ref", "write_set", "budgets", "stop_conditions", "escalation", "accountable_owner"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "kind": {"enum": ["orchestrator", "specialist", "integrator", "verifier", "curator", "operator"]},
          "mission": {"type": "string", "minLength": 1},
          "non_goals": {"type": "array", "items": {"type": "string"}},
          "boundary_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "inputs": {"type": "array", "items": {"type": "string"}},
          "outputs": {"type": "array", "items": {"type": "string"}},
          "tools": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "data_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "model_policy_ref": {"type": "string", "minLength": 1},
          "write_set": {"type": "array", "items": {"type": "string"}},
          "budgets": {"type": "object", "additionalProperties": false, "required": ["max_capabilities"], "properties": {"max_capabilities": {"type": "integer", "minimum": 0}}},
          "stop_conditions": {"type": "array", "items": {"type": "string"}},
          "escalation": {"type": "array", "items": {"type": "string"}},
          "accountable_owner": {"type": "string", "minLength": 1}
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "stages", "integration_owner_ref", "conflict_policy", "cancellation", "partial_failure"],
      "properties": {
        "pattern": {"enum": ["sequential", "pipeline", "fork-join", "dag", "manager", "handoff", "blackboard", "competing-hypotheses"]},
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "role_ref", "depends_on", "artifact_outputs"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "role_ref": {"type": "string", "minLength": 1},
              "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
              "artifact_outputs": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "integration_owner_ref": {"type": "string", "minLength": 1},
        "conflict_policy": {"type": "string", "minLength": 1},
        "cancellation": {"type": "string", "minLength": 1},
        "partial_failure": {"type": "string", "minLength": 1}
      }
    },
    "capability_placement": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability", "decision", "rationale"],
        "properties": {
          "capability": {"type": "string", "minLength": 1},
          "decision": {"enum": ["INLINE", "PRIVATE_COMMAND", "PRIVATE_SKILL", "PUBLIC_SKILL", "TOOL_SCRIPT", "WORKFLOW", "USE_EXISTING", "REJECT"]},
          "owner_agent_ref": {"type": ["string", "null"]},
          "allowed_consumers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "model_policy_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "worktree_policy": {"enum": ["none", "single", "per-worker", "dynamic"]},
    "human_checkpoints": {"type": "array", "items": {"type": "string"}},
    "evaluation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rollback": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "retirement": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
