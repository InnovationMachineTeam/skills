{
  "skill": "agentkit",
  "version": "1.0.0",
  "cases": [
    {
      "id": "script-status-current",
      "script": "scripts/check_donors.py",
      "args": ["--manifest", "donors.json", "--vendor-root", "vendor"],
      "expected_exit": 0,
      "side_effect_policy": "read-only",
      "split": "regression"
    },
    {
      "id": "script-e2e-scaffold",
      "script": "scripts/scaffold_e2e_run.py",
      "args": ["--output", "FIXTURE_NEW_DIR", "--scope", "command", "--command", "status"],
      "expected_exit": 0,
      "side_effect_policy": "new isolated fixture directory only",
      "split": "regression"
    },
    {
      "id": "script-prompt-without-approval",
      "script": "scripts/render_improvement_prompt.py",
      "args": ["--classification", "FIXTURE_CLASSIFICATION", "--approval", "FIXTURE_DENIED_APPROVAL", "--finding-id", "donor-1", "--candidate-destination", "FIXTURE_NEW_CANDIDATE", "--output", "FIXTURE_NEW_PROMPT"],
      "expected_exit": 1,
      "side_effect_policy": "no output",
      "split": "regression"
    },
    {
      "id": "script-router-fixture",
      "script": "scripts/run_router_fixture.py",
      "args": ["--run", "FIXTURE_PLANNED_RUN", "--manifest", "donors.json"],
      "expected_exit": 0,
      "side_effect_policy": "writes only inside the isolated fixture run",
      "split": "regression"
    }
  ]
}
